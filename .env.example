# Local development defaults. Replace model credentials when you want live chat.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL is exposed on POSTGRES_PORT for host-run backend processes.
POSTGRES_DB=analyst
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst
POSTGRES_PORT=55432
# API and worker connect through the exposed host port.
DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:55432/analyst

# RustFS is the default blob store. Set filesystem explicitly for isolated tests.
STORAGE_BACKEND=s3
STORAGE_ROOT=../data

# RustFS development credentials. Keep these defaults on loopback only.
RUSTFS_ACCESS_KEY=analyst-dev
RUSTFS_SECRET_KEY=analyst-dev-secret
RUSTFS_API_PORT=19000
RUSTFS_CONSOLE_PORT=19001
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_ACCESS_KEY=analyst-dev
S3_SECRET_KEY=analyst-dev-secret
S3_BUCKET=analyst
S3_REGION=us-east-1

# API and worker reach the host-run sandbox service directly.
SANDBOX_BASE_URL=http://127.0.0.1:8787
SANDBOX_BIND_HOST=127.0.0.1
SANDBOX_AUTH_TOKEN=
SANDBOX_IMAGE=hari31416/data-science-heavy-runtime:py312-v2@sha256:73520043dc5aa0a30475b8b8a11bf8cc9fea1236540c54b83055d9e876d32fec

# Supply a real key before saving encrypted database credentials.
DATABASE_ENCRYPTION_KEY=
EXTERNAL_PROVIDER_POLICY=local_only
SUPPORTED_LANGUAGES='["en-IN","hi-IN"]'

API_PORT=8000
FRONTEND_PORT=5173
MAX_TOOL_CALLS=20
MAX_MODEL_CALLS=20
RUN_TIMEOUT_SECONDS=300
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
MAX_CONTEXT_CHARACTERS=60000
MAX_RESULT_BYTES=65536
MAX_UPLOAD_BYTES=26214400
